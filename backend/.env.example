# Railway / local API env — copy to .env (never commit .env)

# Prefer the full Atlas driver URI (Connect → Drivers → Node):
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tiptap_manuscript_demo

# Railway sets PORT automatically; local default 8787
PORT=8787

# Comma-separated frontend origins. Also allows https://*.vercel.app by default.
# Example production:
# CORS_ORIGIN=https://tiptap-editor-saving.vercel.app,https://tiptap-editor-saving-git-main-sjinnovation.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional: allow every origin (demo only)
# ALLOW_ALL_CORS=true

# JWT for login sessions (set a long random string on Railway)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d
