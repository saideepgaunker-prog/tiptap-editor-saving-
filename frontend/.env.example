# Frontend (Vercel / local Vite) — copy to .env or .env.local

# Production (Vercel): full Railway API origin, no trailing slash
# Example: https://tiptap-api-production.up.railway.app
VITE_API_BASE=

# Local dev: leave VITE_API_BASE empty so Vite proxies /api → backend (see vite.config.js)
# Optional override for proxy target:
# VITE_DEV_API_PROXY=http://127.0.0.1:8787
