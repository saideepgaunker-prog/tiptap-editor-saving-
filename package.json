{
  "name": "tiptap-nextgen-editor",
  "private": true,
  "version": "1.0.0",
  "description": "TipTap demo — frontend (Vercel) + backend (Railway)",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start --prefix backend",
    "dev:all": "npx concurrently -k \"npm run start --prefix backend\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
